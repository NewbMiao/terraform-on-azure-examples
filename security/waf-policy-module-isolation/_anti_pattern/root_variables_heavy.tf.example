# Anti-pattern — do not write this in the root module.
# Every region's variable repeats the same long object type.
# Change one field and you touch many places. Complex types belong
# in the child module, written once.

variable "policy_sea_dev" {
  type = object({
    name    = string
    enabled = bool
    mode    = string
    managed_rules = list(object({
      type    = string
      version = string
      action  = string
      exclusions = optional(list(object({
        match_variable = string
        operator       = string
        selector       = string
      })), [])
      overrides = optional(list(object({
        rule_group_name = string
        rules = optional(list(object({
          rule_id = string
          enabled = optional(bool, true)
          action  = optional(string)
        })), [])
      })), [])
    }))
    custom_rules = optional(list(object({
      name     = string
      priority = number
      action   = string
      match_conditions = list(object({
        match_variable = string
        operator       = string
        match_values   = list(string)
      }))
    })), [])
  })
}

variable "policy_sea_prod" {
  # … paste the same object({…}) all over again …
  type = any # placeholder in this example file
}

variable "policy_relay_dev" {
  # … paste the same object({…}) all over again …
  type = any
}

variable "policy_relay_prod" {
  # … paste the same object({…}) all over again …
  type = any
}
