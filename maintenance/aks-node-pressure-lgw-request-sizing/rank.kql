// Demo fragment: constants and extend match the lesson's "how the suggestion columns are computed"; in production replace lines with a Perf + KubePodInventory join.
let request_margin = 1.15;
let min_sug_cpu_m = 50.0;
let min_sug_mem_mi = 100.0;
let cpu_lim_peak_buffer = 1.5;
let mem_lim_peak_buffer = 1.3;
let cpu_lim_req_factor = 2.0;
let mem_lim_req_factor = 1.5;
let lines = datatable(
    Namespace:string, Deploy:string, Container:string,
    Req_cpu:real, Req_mem:real, Lim_cpu:real, Lim_mem:real,
    P90_cpu_c:real, Peak_cpu_c:real, P90_mem_peak:real, Peak_mem:real)
[
    "pulse-agent", "checkout-api", "api", 100, 256, 1000, 1024, 0.10, 0.90, 220, 480,
    "pulse-agent", "ingest-worker", "worker", 200, 256, 500, 512, 0.03, 0.05, 200, 220
];
lines
| extend
    Base_cpu_c = P90_cpu_c,
    Base_mem = P90_mem_peak
| extend
    Raw_sug_cpu = max_of(Base_cpu_c * request_margin * 1000.0, min_sug_cpu_m),
    Raw_sug_mem = max_of(Base_mem * request_margin, min_sug_mem_mi)
| extend
    Cpu_step = case(
        Raw_sug_cpu <= 200.0, 50.0,
        Raw_sug_cpu <= 500.0, 100.0,
        Raw_sug_cpu <= 1500.0, 250.0,
        Raw_sug_cpu <= 3000.0, 500.0,
        1000.0),
    Mem_step = 100.0
| extend
    Sug_cpu = ceiling(Raw_sug_cpu / Cpu_step) * Cpu_step,
    Sug_mem = ceiling(Raw_sug_mem / Mem_step) * Mem_step
| extend
    Basis_cpu = max_of(Req_cpu, Sug_cpu),
    Basis_mem = max_of(Req_mem, Sug_mem)
| extend
    Raw_lim_cpu_m = max_of(Peak_cpu_c * cpu_lim_peak_buffer * 1000.0, min_sug_cpu_m),
    Raw_lim_mem_Mi = max_of(Peak_mem * mem_lim_peak_buffer, min_sug_mem_mi),
    Raw_lim_cpu_bp = max_of(Basis_cpu * cpu_lim_req_factor, min_sug_cpu_m),
    Raw_lim_mem_bp = max_of(Basis_mem * mem_lim_req_factor, min_sug_mem_mi)
| extend
    Raw_sug_lim_cpu = max_of(Raw_lim_cpu_m, Raw_lim_cpu_bp),
    Raw_sug_lim_mem = max_of(Raw_lim_mem_Mi, Raw_lim_mem_bp)
| extend
    Lim_cpu_step = case(
        Raw_sug_lim_cpu <= 200.0, 50.0,
        Raw_sug_lim_cpu <= 500.0, 100.0,
        Raw_sug_lim_cpu <= 1500.0, 250.0,
        Raw_sug_lim_cpu <= 3000.0, 500.0,
        1000.0),
    Lim_mem_step = 100.0
| extend
    Sug_lim_cpu_t = ceiling(Raw_sug_lim_cpu / Lim_cpu_step) * Lim_cpu_step,
    Sug_lim_mem_t = ceiling(Raw_sug_lim_mem / Lim_mem_step) * Lim_mem_step
| extend
    Sug_lim_cpu = max_of(Sug_cpu, Sug_lim_cpu_t),
    Sug_lim_mem = max_of(Sug_mem, Sug_lim_mem_t)
| where
    Sug_mem > Req_mem * 1.02 or Sug_cpu > Req_cpu * 1.02
    or Req_mem > Sug_mem * 1.02 or Req_cpu > Sug_cpu * 1.02
| order by Namespace asc, Deploy asc, Container asc
| extend
    P90_cpu = todouble(round(P90_cpu_c * 1000.0, 0)),
    Peak_cpu = todouble(round(Peak_cpu_c * 1000.0, 0)),
    Req_cpu = todouble(Req_cpu),
    Lim_cpu = Lim_cpu,
    Sug_cpu = todouble(Sug_cpu),
    Sug_lim_cpu = todouble(Sug_lim_cpu),
    Req_mem = todouble(Req_mem),
    Lim_mem = Lim_mem,
    Sug_mem = todouble(Sug_mem),
    Sug_lim_mem = todouble(Sug_lim_mem),
    P90_mem_peak = todouble(round(P90_mem_peak, 0)),
    Peak_mem = todouble(round(Peak_mem, 0))
| project
    Namespace,
    Deployment = Deploy,
    Container,
    Req_cpu,
    Sug_cpu,
    Lim_cpu,
    Sug_lim_cpu,
    P90_cpu,
    Peak_cpu,
    Req_mem,
    Sug_mem,
    Lim_mem,
    Sug_lim_mem,
    P90_mem_peak,
    Peak_mem
